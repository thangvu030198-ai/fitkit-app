# Sao chép thành functions/.env rồi điền (file .env KHÔNG chứa bí mật — khoá .p8 để trong Secret Manager)
# Team ID: developer.apple.com → Membership details
APPLE_TEAM_ID=XXXXXXXXXX
# Key ID của key có bật "Sign in with Apple" (tên file AuthKey_<KEYID>.p8)
APPLE_KEY_ID=YYYYYYYYYY
# client_id cho mã lấy từ app iOS = Bundle ID
APPLE_BUNDLE_ID=vn.thangvu.fitkit
# client_id cho token lấy qua Firebase (web / Android) = Services ID đã khai báo ở Firebase → Authentication → Apple
APPLE_SERVICES_ID=vn.thangvu.fitkit.web
