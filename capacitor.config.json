{
  "appId": "vn.thangvu.fitkit",
  "appName": "TapEasy",
  "webDir": "www",
  "backgroundColor": "#061A24",
  "ios": {
    "contentInset": "never",
    "scheme": "FitKit",
    "backgroundColor": "#061A24"
  },
  "android": {
    "backgroundColor": "#061A24",
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
  },
  "server": {
    "androidScheme": "https",
    "cleartext": false
  },
  "plugins": {
    "LocalNotifications": {
      "iconColor": "#02BCB3"
    },
    "CapacitorHttp": {
      "enabled": true
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "apple.com",
        "google.com"
      ]
    }
  }
}
